# Kopieer naar `.env` in de repo-root en vul in. `.env` wordt NOOIT gecommit (zie .gitignore).

# R33-gateway (verplicht)
R33_API_KEY=
ANTHROPIC_BASE_URL=https://api.route33.ai

# Alleen invullen als je rechtstreeks bij Anthropic zit (dan R33_API_KEY leeg laten)
ANTHROPIC_API_KEY=

# Google Fact Check Tools API
GOOGLE_FACTCHECK_API_KEY=

# Let op: de R33-gateway verwacht een provider-prefix.
LLM_MODEL=anthropic/claude-sonnet-5-5

# Poort waarop Traefik luistert (lokaal)
TRAEFIK_PORT=8080
